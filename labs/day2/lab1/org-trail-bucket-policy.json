{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSCloudTrailAclCheck",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": {
        "StringEquals": { "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:__MGMT_ACCT__:trail/skyfortress-org-trail" }
      }
    },
    {
      "Sid": "AWSCloudTrailWriteManagementAccount",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__BUCKET__/AWSLogs/__MGMT_ACCT__/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:__MGMT_ACCT__:trail/skyfortress-org-trail"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWriteOrganization",
      "Effect": "Allow",
      "Principal": { "Service": "cloudtrail.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__BUCKET__/AWSLogs/__ORG_ID__/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-1:__MGMT_ACCT__:trail/skyfortress-org-trail"
        }
      }
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::__BUCKET__", "arn:aws:s3:::__BUCKET__/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "DenyLogDeletionByAnyone",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutLifecycleConfiguration"],
      "Resource": ["arn:aws:s3:::__BUCKET__", "arn:aws:s3:::__BUCKET__/*"],
      "Condition": { "StringNotLike": { "aws:PrincipalArn": "arn:aws:iam::__MGMT_ACCT__:role/skyfortress-log-steward" } }
    }
  ]
}
