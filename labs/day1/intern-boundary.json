{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingForDeveloperRoles",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "logs:*",
        "iam:ListRoles",
        "iam:GetRole",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRoleCeiling",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/lambda-sandbox/*"
    },
    {
      "Sid": "NeverTouchPrivilegedPath",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": "arn:aws:iam::*:role/privileged/*"
    }
  ]
}
