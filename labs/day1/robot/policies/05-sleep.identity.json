{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTelemetry",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::nimbus-telemetry-raw/*"
    },
    {
      "Sid": "LetTheBuildPassRolesItsFine",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*"
    }
  ]
}
