{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ShareDashboardsInsideTheOrgOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::nimbus-telemetry-dashboards/*",
      "Condition": {
        "StringEquals": { "aws:PrincipalOrgID": "o-exampleorgid" }
      }
    }
  ]
}
