{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TelemetryReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::nimbus-telemetry-*",
        "arn:aws:s3:::nimbus-telemetry-*/*"
      ]
    },
    {
      "Sid": "TelemetryQueue",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage"],
      "Resource": "arn:aws:sqs:us-east-1:*:nimbus-telemetry-*"
    }
  ]
}
